  "oversized_generators": [
    {"id":"input_over_65536_bytes","rule":"generate UTF-8 JSON input whose encoded length exceeds 65536"},
    {"id":"depth_over_32","rule":"generate nested arrays with logical depth greater than 32"},
    {"id":"string_over_8192_utf8_bytes","rule":"generate one decoded NFC string exceeding 8192 UTF-8 bytes"},
    {"id":"array_over_1024_items","rule":"generate an array containing more than 1024 items"},
    {"id":"object_over_1024_members","rule":"generate an object containing more than 1024 members"}
  ]
