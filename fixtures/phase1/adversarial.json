{
  "profile": "qsol-fed-canonical-json/1",
  "cases": [
    {"id":"duplicate_key","raw":"{\"a\":1,\"a\":2}","expect":"reject"},
    {"id":"normalized_duplicate_key","raw":"{\"é\":1,\"e\\u0301\":2}","expect":"reject"},
    {"id":"decimal_number","raw":"{\"n\":1.0}","expect":"reject"},
    {"id":"exponent_number","raw":"{\"n\":1e0}","expect":"reject"},
    {"id":"nan_extension","raw":"{\"n\":NaN}","expect":"reject"},
    {"id":"positive_infinity_extension","raw":"{\"n\":Infinity}","expect":"reject"},
    {"id":"negative_infinity_extension","raw":"{\"n\":-Infinity}","expect":"reject"},
    {"id":"safe_integer_overflow","raw":"{\"n\":9007199254740992}","expect":"reject"},
    {"id":"safe_integer_underflow","raw":"{\"n\":-9007199254740992}","expect":"reject"},
    {"id":"utf8_bom","raw":"﻿{\"a\":1}","expect":"reject"},
    {"id":"lone_surrogate","raw":"{\"s\":\"\\ud800\"}","expect":"reject"},
    {"id":"trailing_comma","raw":"{\"a\":1,}","expect":"reject"},
    {"id":"comment_extension","raw":"{\"a\":1/*nope*/}","expect":"reject"},
    {"id":"multiple_documents","raw":"{\"a\":1}{\"b\":2}","expect":"reject"}
