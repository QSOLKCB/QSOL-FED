{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsol-fed-holodeck-program/1",
  "title": "QSOL-FED Holodeck Program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "seed", "mode", "max_events", "max_entities", "safety_profile", "authority_effect"],
  "properties": {
    "schema": {"const": "qsol-fed-holodeck-program/1"},
    "source": {"$ref": "nexus-world-source-v1.schema.json"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "mode": {"enum": ["reconstruction", "counterfactual", "exploration", "training", "adversarial_simulation"]},
    "max_events": {"type": "integer", "minimum": 1, "maximum": 4096},
    "max_entities": {"type": "integer", "minimum": 1, "maximum": 256},
    "safety_profile": {"const": "qsol-fed-holodeck-safety/1"},
    "authority_effect": {"const": "none"}
  }
}
