{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schema/qsol-fed-envelope-1",
  "title": "QSOL-FED Federation Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol","message_id","sender","recipient","message_class","payload_ref","provenance_ref","issued_at","expires_at","authority_claim","signature"],
  "properties": {
    "protocol": {"const": "qsol-fed/1"},
    "message_id": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "sender": {"type":"string","pattern":"^fed:qsol:[a-z0-9][a-z0-9._-]{0,127}$"},
    "recipient": {"type":"string","pattern":"^fed:qsol:[a-z0-9][a-z0-9._-]{0,127}$"},
    "message_class": {"enum":["hello","capabilities","evidence.offer","evidence.request","hypothesis","challenge","response","council.report","minority.report","experiment.receipt","citation","publication"]},
    "payload_ref": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "provenance_ref": {"oneOf":[{"type":"null"},{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}]},
    "issued_at": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"oneOf":[{"type":"null"},{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}]},
    "authority_claim": {"const":"none"},
    "signature": {"type":"null"}
  }
}
