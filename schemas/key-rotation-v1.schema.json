{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/key-rotation-v1.schema.json",
  "title": "QSOL-FED Operational Key Rotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "algorithm", "sequence", "mode", "previous_key_id", "next_key_id", "next_public_key", "not_before", "overlap_until", "previous_signature", "next_signature", "root_signature"],
  "properties": {
    "schema": {"const": "qsol-fed-key-rotation/1"},
    "node_id": {"type": "string", "pattern": "^fed:qsol:[0-9a-f]{64}$"},
    "algorithm": {"const": "ed25519"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "mode": {"enum": ["transition", "recovery"]},
    "previous_key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "next_key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
    "next_public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "not_before": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "overlap_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "previous_signature": {"type": ["string", "null"], "pattern": "^[0-9a-f]{128}$"},
    "next_signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "root_signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  }
}
