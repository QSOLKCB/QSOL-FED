{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsol-fed-peer-hello/1",
  "title": "QSOL-FED Peer Hello v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "identity",
    "capabilities",
    "authority_claim"
  ],
  "properties": {
    "schema": {
      "const": "qsol-fed-peer-hello/1"
    },
    "protocol": {
      "const": "qsol-fed/1"
    },
    "identity": {
      "$ref": "node-identity-v1.schema.json"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/[1-9][0-9]*$"
      }
    },
    "authority_claim": {
      "const": "none"
    }
  }
}
