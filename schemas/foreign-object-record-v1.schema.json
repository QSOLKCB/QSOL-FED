{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsol-fed-foreign-object/1",
  "title": "QSOL-FED Foreign Object Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "object_id", "source_node", "provenance_id", "namespace", "received_at", "authority"],
  "properties": {
    "schema": {"const": "qsol-fed-foreign-object/1"},
    "object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_node": {"type": "string", "pattern": "^fed:qsol:[a-z0-9][a-z0-9._-]{0,127}$"},
    "provenance_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "namespace": {"enum": ["foreign", "quarantine"]},
    "received_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authority": {"const": "none"}
  }
}
