{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/moriarty-counterexample-v1.schema.json",
  "title": "MORIARTY/1 locally reproduced counterexample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "counterexample_id",
    "target_commit",
    "attack_id",
    "family",
    "owner_phases",
    "boundary_ids",
    "regression_probe_ids",
    "failure_kind",
    "observed_exit_code",
    "stdout_sha256",
    "stderr_sha256",
    "stdout_bytes",
    "stderr_bytes",
    "status",
    "resolution_commit",
    "production_credentials_used",
    "production_targets_used",
    "constitutional_bypass_used",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "moriarty-counterexample/1"
    },
    "counterexample_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "attack_id": {
      "type": "string",
      "pattern": "^MOR-[0-9]{3}$"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner_phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "boundary_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_./-]{1,128}$"
      }
    },
    "regression_probe_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,64}$"
      }
    },
    "failure_kind": {
      "type": "string",
      "enum": [
        "exit_nonzero",
        "timeout",
        "tool_error"
      ]
    },
    "observed_exit_code": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "stderr_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved"
      ]
    },
    "resolution_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "production_credentials_used": {
      "const": false
    },
    "production_targets_used": {
      "const": false
    },
    "constitutional_bypass_used": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "failure_kind": {
            "const": "exit_nonzero"
          }
        },
        "required": [
          "failure_kind"
        ]
      },
      "then": {
        "properties": {
          "observed_exit_code": {
            "type": "integer",
            "not": {
              "const": 0
            }
          }
        }
      },
      "else": {
        "properties": {
          "observed_exit_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unresolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolution_commit": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "resolution_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    }
  ]
}
