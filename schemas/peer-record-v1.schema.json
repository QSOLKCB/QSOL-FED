{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsol-fed-peer-record/1",
  "title": "QSOL-FED Durable Peer Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "node_id", "identity", "lifecycle", "identity_fingerprint", "lifecycle_sequence",
    "state", "pre_disconnect_state", "partition_snapshot", "capability_advertisement",
    "local_event_sequence", "updated_at", "authority"
  ],
  "properties": {
    "schema": {"const": "qsol-fed-peer-record/1"},
    "node_id": {"type": "string", "pattern": "^fed:qsol:[a-z0-9][a-z0-9._-]{0,127}$"},
    "identity": {"$ref": "node-identity-v1.schema.json"},
    "lifecycle": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "oneOf": [
          {"$ref": "key-rotation-v1.schema.json"},
          {"$ref": "key-status-v1.schema.json"}
        ]
      }
    },
    "identity_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lifecycle_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "state": {"enum": ["introduced", "admitted", "quarantined", "revoked", "disconnected"]},
    "pre_disconnect_state": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["introduced", "admitted", "quarantined", "revoked", "disconnected"]}
      ]
    },
    "partition_snapshot": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "capability_advertisement": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "capability-advertisement-v1.schema.json"}
      ]
    },
    "local_event_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "authority": {"const": "none"}
  }
}
