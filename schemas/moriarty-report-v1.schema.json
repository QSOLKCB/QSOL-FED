{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/moriarty-report-v1.schema.json",
  "title": "MORIARTY/1 exact-commit graduation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "target_commit",
    "corpus_ref",
    "operator_profile",
    "family_count",
    "executed_probe_count",
    "probe_results",
    "remediation_replays",
    "counterexamples",
    "unresolved_counterexamples",
    "graduated",
    "production_credentials_used",
    "production_targets_used",
    "constitutional_bypass_used",
    "security_proof",
    "no_counterexample_found_implies_none_exist",
    "authority_effect"
  ],
  "properties": {
    "schema": {
      "const": "moriarty-report/1"
    },
    "protocol": {
      "const": "MORIARTY/1"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "corpus_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operator_profile": {
      "const": "provider-neutral-fixed-probe/1"
    },
    "family_count": {
      "const": 15
    },
    "executed_probe_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "probe_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "probe_id",
          "ok",
          "exit_code",
          "failure_kind",
          "stdout_sha256",
          "stderr_sha256",
          "stdout_bytes",
          "stderr_bytes",
          "stdout_truncated",
          "stderr_truncated"
        ],
        "properties": {
          "probe_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "ok": {
            "type": "boolean"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "failure_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "exit_nonzero",
              "timeout",
              "tool_error"
            ]
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "stdout_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "stderr_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "stdout_truncated": {
            "type": "boolean"
          },
          "stderr_truncated": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "properties": {
                "exit_code": {
                  "const": 0
                },
                "failure_kind": {
                  "const": null
                },
                "stdout_truncated": {
                  "const": false
                },
                "stderr_truncated": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "properties": {
                "failure_kind": {
                  "enum": [
                    "exit_nonzero",
                    "timeout",
                    "tool_error"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "failure_kind": {
                  "const": "exit_nonzero"
                }
              },
              "required": [
                "failure_kind"
              ]
            },
            "then": {
              "properties": {
                "ok": {
                  "const": false
                },
                "exit_code": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "failure_kind": {
                  "enum": [
                    "timeout",
                    "tool_error"
                  ]
                }
              },
              "required": [
                "failure_kind"
              ]
            },
            "then": {
              "properties": {
                "ok": {
                  "const": false
                },
                "exit_code": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "anyOf": [
                {
                  "properties": {
                    "stdout_truncated": {
                      "const": true
                    }
                  },
                  "required": [
                    "stdout_truncated"
                  ]
                },
                {
                  "properties": {
                    "stderr_truncated": {
                      "const": true
                    }
                  },
                  "required": [
                    "stderr_truncated"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "ok": {
                  "const": false
                },
                "failure_kind": {
                  "const": "tool_error"
                }
              }
            }
          }
        ]
      }
    },
    "counterexamples": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "$ref": "moriarty-counterexample-v1.schema.json"
      }
    },
    "unresolved_counterexamples": {
      "type": "integer",
      "minimum": 0,
      "maximum": 48
    },
    "graduated": {
      "type": "boolean"
    },
    "production_credentials_used": {
      "const": false
    },
    "production_targets_used": {
      "const": false
    },
    "constitutional_bypass_used": {
      "const": false
    },
    "security_proof": {
      "const": false
    },
    "no_counterexample_found_implies_none_exist": {
      "const": false
    },
    "authority_effect": {
      "const": "none"
    },
    "remediation_replays": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "counterexample_id",
          "status",
          "probe_id",
          "ok",
          "target_reproduced",
          "resolution_green",
          "failure_kind",
          "failure_result"
        ],
        "properties": {
          "counterexample_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "unresolved",
              "resolved"
            ]
          },
          "probe_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "ok": {
            "type": "boolean"
          },
          "target_reproduced": {
            "type": "boolean"
          },
          "resolution_green": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "failure_kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "target_failure_not_reproduced",
              "resolution_probe_not_green",
              "replay_setup_error"
            ]
          },
          "failure_result": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "probe_id",
              "ok",
              "exit_code",
              "failure_kind",
              "stdout_sha256",
              "stderr_sha256",
              "stdout_bytes",
              "stderr_bytes",
              "stdout_truncated",
              "stderr_truncated"
            ],
            "properties": {
              "probe_id": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,64}$"
              },
              "ok": {
                "type": "boolean"
              },
              "exit_code": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              "failure_kind": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "exit_nonzero",
                  "timeout",
                  "tool_error"
                ]
              },
              "stdout_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "stderr_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "stdout_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "stderr_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "stdout_truncated": {
                "type": "boolean"
              },
              "stderr_truncated": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ]
                },
                "then": {
                  "properties": {
                    "exit_code": {
                      "const": 0
                    },
                    "failure_kind": {
                      "const": null
                    },
                    "stdout_truncated": {
                      "const": false
                    },
                    "stderr_truncated": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "const": false
                    }
                  },
                  "required": [
                    "ok"
                  ]
                },
                "then": {
                  "properties": {
                    "failure_kind": {
                      "enum": [
                        "exit_nonzero",
                        "timeout",
                        "tool_error"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "failure_kind": {
                      "const": "exit_nonzero"
                    }
                  },
                  "required": [
                    "failure_kind"
                  ]
                },
                "then": {
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "exit_code": {
                      "type": "integer",
                      "not": {
                        "const": 0
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "failure_kind": {
                      "enum": [
                        "timeout",
                        "tool_error"
                      ]
                    }
                  },
                  "required": [
                    "failure_kind"
                  ]
                },
                "then": {
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "exit_code": {
                      "const": null
                    }
                  }
                }
              },
              {
                "if": {
                  "type": "object",
                  "anyOf": [
                    {
                      "properties": {
                        "stdout_truncated": {
                          "const": true
                        }
                      },
                      "required": [
                        "stdout_truncated"
                      ]
                    },
                    {
                      "properties": {
                        "stderr_truncated": {
                          "const": true
                        }
                      },
                      "required": [
                        "stderr_truncated"
                      ]
                    }
                  ]
                },
                "then": {
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "failure_kind": {
                      "const": "tool_error"
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "properties": {
                "target_reproduced": {
                  "const": true
                },
                "failure_kind": {
                  "const": null
                },
                "failure_result": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "ok": {
                  "const": false
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "properties": {
                "failure_kind": {
                  "enum": [
                    "target_failure_not_reproduced",
                    "resolution_probe_not_green",
                    "replay_setup_error"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unresolved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "resolution_green": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "allOf": [
                {
                  "properties": {
                    "status": {
                      "const": "resolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                {
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              ]
            },
            "then": {
              "properties": {
                "resolution_green": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "failure_kind": {
                  "const": "target_failure_not_reproduced"
                }
              },
              "required": [
                "failure_kind"
              ]
            },
            "then": {
              "properties": {
                "ok": {
                  "const": false
                },
                "target_reproduced": {
                  "const": false
                },
                "failure_result": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "failure_kind": {
                  "const": "resolution_probe_not_green"
                }
              },
              "required": [
                "failure_kind"
              ]
            },
            "then": {
              "properties": {
                "ok": {
                  "const": false
                },
                "target_reproduced": {
                  "const": true
                },
                "resolution_green": {
                  "const": false
                },
                "failure_result": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "graduated": {
            "const": true
          }
        },
        "required": [
          "graduated"
        ]
      },
      "then": {
        "properties": {
          "unresolved_counterexamples": {
            "const": 0
          },
          "probe_results": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            }
          },
          "remediation_replays": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            }
          },
          "counterexamples": {
            "items": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "graduated": {
            "const": false
          }
        },
        "required": [
          "graduated"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "unresolved_counterexamples": {
                "minimum": 1
              }
            }
          },
          {
            "properties": {
              "probe_results": {
                "contains": {
                  "properties": {
                    "ok": {
                      "const": false
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "remediation_replays": {
                "contains": {
                  "properties": {
                    "ok": {
                      "const": false
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "counterexamples": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "unresolved"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
