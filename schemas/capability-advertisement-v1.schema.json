{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsol-fed-capability-advertisement/1",
  "title": "QSOL-FED Capability Advertisement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "sequence", "issued_at", "expires_at", "capabilities", "proof"],
  "properties": {
    "schema": {"const": "qsol-fed-capability-advertisement/1"},
    "node_id": {"type": "string", "pattern": "^fed:qsol:[a-z0-9][a-z0-9._-]{0,127}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*/[1-9][0-9]*$"}
    },
    "proof": {"$ref": "signed-envelope-v1.schema.json"}
  }
}
