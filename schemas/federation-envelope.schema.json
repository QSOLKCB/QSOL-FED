{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qsol.example/schemas/federation-envelope.schema.json",
  "title": "QSOL-FED Bootstrap Federation Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "message_id",
    "sender",
    "recipient",
    "message_class",
    "payload_ref",
    "provenance_ref",
    "issued_at",
    "expires_at",
    "authority_claim",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "qsol-fed/0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sender": {
      "type": "string",
      "pattern": "^fed:qsol:[A-Za-z0-9._~-]{1,128}$"
    },
    "recipient": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "message_class": {
      "enum": [
        "hello",
        "capabilities",
        "evidence.offer",
        "evidence.request",
        "hypothesis",
        "challenge",
        "response",
        "council.report",
        "minority.report",
        "experiment.receipt",
        "citation",
        "publication"
      ]
    },
    "payload_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "authority_claim": {
      "const": "none"
    },
    "signature": {
      "type": ["string", "null"],
      "description": "Bootstrap placeholder. Cryptographic suite and canonical signing bytes are not frozen by PR #1."
    }
  }
}
