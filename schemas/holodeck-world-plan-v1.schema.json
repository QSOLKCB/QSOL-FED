{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qsol-fed-holodeck-world-plan/1",
  "title": "QSOL-FED Holodeck World Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "program_id",
    "world_id",
    "seed",
    "source_order",
    "anchor_refs",
    "synthetic_entity_ids",
    "authority_effect"
  ],
  "properties": {
    "schema": {"const": "qsol-fed-holodeck-world-plan/1"},
    "program_id": {"type": "string", "pattern": "^holodeck-program:[0-9a-f]{64}$"},
    "world_id": {"type": "string", "pattern": "^holodeck-world:[0-9a-f]{64}$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "source_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^object:[0-9a-f]{64}$"}
    },
    "anchor_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "x-qsol-subsetOf": "source_order",
      "items": {"type": "string", "pattern": "^object:[0-9a-f]{64}$"}
    },
    "synthetic_entity_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^holo-entity:[0-9a-f]{24}:[0-9]+$"}
    },
    "authority_effect": {"const": "none"}
  }
}
